# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Testing / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data & artifacts (keep the dirs, ignore contents)
data/
results/*
!results/.gitkeep
# The compact, versioned final-result manifest is intentionally tracked. Large
# experiment artifacts under this directory remain ignored and are archived
# separately with checksums.
!results/v2/
!results/v2/manifest.json
!results/v3/
!results/v3/manifest.json
models/*
!models/.gitkeep
*.pkl
*.joblib
*.pt
*.npz

# Generated grid configs (regenerable from configs/*.spec.yaml)
configs/gridA/
configs/gridB/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
